# Prototipo 1 - ArquiSoft : configuracion de entorno
# Copia este archivo a `.env` antes de levantar el sistema:
#   cp .env.example .env
# Para la demo los valores por defecto funcionan tal cual.

# ---- Puertos expuestos en la maquina host ----
# Si alguno choca con otro servicio local (p. ej. portainer suele usar 8000),
# cambia aqui el puerto del host; el del contenedor interno no cambia.
FRONT_PORT=5173
PAGOS_PORT=8000
MOTOR_PORT=8080

# ---- PostgreSQL (Pagos y usuarios) ----
POSTGRES_USER=arqui
POSTGRES_PASSWORD=arqui_pass
POSTGRES_DB=arqui_pagos

# ---- MongoDB (Motor de apuestas) ----
MONGO_USER=arqui
MONGO_PASSWORD=arqui_pass
MONGO_DB=arqui_motor

# ---- Autenticacion / JWT (compartido entre pagos y motor, RNF-06) ----
JWT_SECRET=cambia-esta-clave-super-secreta-en-produccion
JWT_EXPIRE_MINUTES=120

# ---- Economia del token (RF-03) ----
# Cuantos COP vale 1 token. Tasa fija configurable para el prototipo.
COP_PER_TOKEN=1000

# ---- Usuario administrador (RF-13 / HU-12) ----
# Se crea automaticamente al desplegar. El registro publico nunca crea admins.
ADMIN_EMAIL=admin@arqui.local
ADMIN_PASSWORD=admin1234
ADMIN_NAME=Administrador

# ---- Ciclo del mercado (RF-07, RF-09, RNF-05) ----
BETTING_WINDOW_SECONDS=30
OBSERVATION_WINDOW_SECONDS=60
